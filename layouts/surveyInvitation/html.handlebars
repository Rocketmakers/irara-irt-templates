<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html dir="ltr" lang="en">
  <head>
    <link
      rel="preload"
      as="image"
      href="https://raw.githubusercontent.com/Rocketmakers/irara-irt-templates/main/assets/logo.png" />
    <meta content="text/html; charset=UTF-8" http-equiv="Content-Type" />
    <meta name="x-apple-disable-message-reformatting" />
  </head>
  <body style="background-color:#FFFFFF;margin:0">
    <!--$--><!--html--><!--head-->
    <div
      style="display:none;overflow:hidden;line-height:1px;opacity:0;max-height:0;max-width:0"
      data-skip-in-text="true">
      We invite you to complete the {{surveyName}} questionnaire about your
      return and your situation now. Complete it yourself, in your own words.
      <div> ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿</div>
    </div>
    <!--body-->
    <table
      border="0"
      width="100%"
      cellpadding="0"
      cellspacing="0"
      role="presentation"
      align="center">
      <tbody>
        <tr>
          <td
            style="margin:0px;background-color:#FFFFFF;color:#384757;font-size:16px;font-family:Inter,-apple-system,BlinkMacSystemFont,&#x27;Segoe UI&#x27;,Roboto,Helvetica,Arial,sans-serif">
            <table
              align="center"
              width="100%"
              border="0"
              cellpadding="0"
              cellspacing="0"
              role="presentation"
              style="border-top:6px solid #275dbf;border-bottom:1px solid #eaedf2">
              <tbody>
                <tr>
                  <td>
                    <table
                      align="center"
                      width="100%"
                      border="0"
                      cellpadding="0"
                      cellspacing="0"
                      role="presentation"
                      style="max-width:600px;margin:0 auto">
                      <tbody>
                        <tr style="width:100%">
                          <td>
                            <table
                              align="center"
                              width="100%"
                              border="0"
                              cellpadding="0"
                              cellspacing="0"
                              role="presentation"
                              style="padding:28px 40px">
                              <tbody>
                                <tr>
                                  <td>
                                    <img
                                      alt="IRARA"
                                      height="35"
                                      src="https://raw.githubusercontent.com/Rocketmakers/irara-irt-templates/main/assets/logo.png"
                                      style="display:block;outline:none;border:none;text-decoration:none"
                                      width="144" />
                                  </td>
                                </tr>
                              </tbody>
                            </table>
                          </td>
                        </tr>
                      </tbody>
                    </table>
                  </td>
                </tr>
              </tbody>
            </table>
            <table
              align="center"
              width="100%"
              border="0"
              cellpadding="0"
              cellspacing="0"
              role="presentation"
              style="max-width:600px;margin:0 auto">
              <tbody>
                <tr style="width:100%">
                  <td>
                    <table
                      align="center"
                      width="100%"
                      border="0"
                      cellpadding="0"
                      cellspacing="0"
                      role="presentation"
                      style="padding:40px 40px 32px;text-align:left">
                      <tbody>
                        <tr>
                          <td>
                            <p
                              style="font-size:14px;line-height:20px;margin:0 0 12px;font-weight:600;letter-spacing:0.5px;text-transform:uppercase;color:#275dbf;margin-top:0;margin-right:0;margin-bottom:12px;margin-left:0">
                              {{surveyName}}
                            </p>
                            <h1
                              style="margin:0 0 24px;font-size:30px;line-height:38px;font-weight:600;color:#181f25">
                              Monitoring &amp; Evaluation
                            </h1>
                            <p
                              style="font-size:16px;line-height:26px;margin:0 0 16px;color:#384757;margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0">
                              Hello {{forename}},
                            </p>
                            <p
                              style="font-size:16px;line-height:26px;margin:0 0 16px;color:#384757;margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0">
                              We invite you to complete the {{surveyName}}
                              questionnaire about your return and your situation
                              now. Complete it yourself, in your own words.
                            </p>
                            <a
                              href="{{surveyUrl}}"
                              style="line-height:20px;text-decoration:none;display:inline-block;max-width:100%;mso-padding-alt:0px;margin:8px 0 24px;padding:16px 36px;background-color:#275dbf;border-radius:999px;color:#FFFFFF;font-size:16px;font-weight:600;padding-top:16px;padding-right:36px;padding-bottom:16px;padding-left:36px"
                              target="_blank"
                              ><span
                                ><!--[if mso]><i style="mso-font-width:450%;mso-text-raise:24" hidden>&#8202;&#8202;&#8202;&#8202;</i><![endif]--></span
                              ><span
                                style="max-width:100%;display:inline-block;line-height:120%;mso-padding-alt:0px;mso-text-raise:12px"
                                >Complete the questionnaire</span
                              ><span
                                ><!--[if mso]><i style="mso-font-width:450%" hidden>&#8202;&#8202;&#8202;&#8202;&#8203;</i><![endif]--></span
                              ></a
                            >
                            <p
                              style="font-size:14px;line-height:22px;margin:0 0 16px;color:#5b6878;margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0">
                              Your progress saves automatically as you complete
                              the questionnaire. Submitting your answers is a
                              separate action.
                            </p>
                            <p
                              style="font-size:14px;line-height:22px;margin:0 0 16px;color:#5b6878;margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0">
                              This link is for you only. Please do not share it
                              with anyone else.
                            </p>
                            <p
                              style="font-size:14px;line-height:22px;margin:0 0 4px;color:#5b6878;margin-top:0;margin-right:0;margin-bottom:4px;margin-left:0">
                              If the button does not work, copy this link into
                              your browser:
                            </p>
                            <a
                              href="{{surveyUrl}}"
                              style="color:#275dbf;text-decoration-line:none;font-size:14px;line-height:22px;text-decoration:none;word-break:break-all"
                              target="_blank"
                              >{{surveyUrl}}</a
                            >
                            <hr
                              style="width:100%;border:none;border-top:1px solid #eaedf2;margin:28px 0" />
                            <p
                              style="font-size:16px;line-height:24px;margin:0 0 8px;font-weight:600;color:#181f25;margin-top:0;margin-right:0;margin-bottom:8px;margin-left:0">
                              If you need support
                            </p>
                            <p
                              style="font-size:14px;line-height:22px;margin:0 0 16px;color:#5b6878;margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0">
                              This questionnaire is not a way to request
                              individual help. The team cannot contact you from
                              your answers. If you need medical or mental
                              wellbeing support, please seek help directly from
                              a suitable local service.
                            </p>
                            <p
                              style="font-size:16px;line-height:26px;margin:24px 0 16px;color:#384757;margin-top:24px;margin-right:0;margin-bottom:16px;margin-left:0">
                              Thank you for considering sharing your experience.
                            </p>
                            <p
                              style="font-size:16px;line-height:24px;margin:0px;font-weight:600;color:#181f25;margin-top:0px;margin-bottom:0px;margin-left:0px;margin-right:0px">
                              IRARA
                            </p>
                          </td>
                        </tr>
                      </tbody>
                    </table>
                  </td>
                </tr>
              </tbody>
            </table>
          </td>
        </tr>
      </tbody>
    </table>
    <!--/$-->
  </body>
</html>
